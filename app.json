{
  "expo": {
    "name": "Bimo",
    "slug": "Bimo",
    "version": "1.1.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bimo",
    "userInterfaceStyle": "automatic",
    "android": {
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mohammed007007.Bimo",
      "permissions": [
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "buildNumber": "3",
      "supportsTablet": true,
      "bundleIdentifier": "com.mohammed007007.Bimo",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Bimo to access your photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow Bimo to save photos to your gallery."
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Bimo to access your photos.",
          "savePhotosPermission": "Allow Bimo to save photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      "expo-localization",
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-audio",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4fdef2c-34b2-49d1-b6fd-e3a38f0b9ea6"
      }
    }
  }
}
